# =============================================================================
# .env.example  -  template for your API keys
#
# 1. Copy this file to a new file named ".env"   (cp .env.example .env)
# 2. Replace each placeholder with your own key
# 3. NEVER commit ".env" - it is already listed in .gitignore
#
# You only need keys for the providers you want to try.
# =============================================================================

# OpenAI  -> https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini  -> https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# OpenRouter (one key, many models)  -> https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional - used in later modules
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
